    "stdout",
    "stderr",
    "ndjson",
    "logging",
    "audit",
    "debugging",
    "testing",
    "command-line",
    "xterm"
  ],
  "license": "MIT",
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@jon.soy",
    "url": "https://jon.soy"
  },
  "homepage": "https://github.com/JonDotsoy/binrec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/binrec.git"
  },
  "bugs": {
    "url": "https://github.com/JonDotsoy/binrec/issues",
    "email": "hi@jon.soy"
  },
  "module": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "bin": {
    "binrec": "bin/binrec.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
